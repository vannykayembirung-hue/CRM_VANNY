# EXEMPLE UNIQUEMENT — ne mettez jamais de vraies valeurs dans ce fichier.
# Configurez les secrets dans l'environnement serveur / le gestionnaire de secrets du déploiement.

# NEON POSTGRESQL — variable réservée au serveur, jamais au navigateur.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# CLERK — la clé publique peut être utilisée côté client ; la clé secrète reste serveur uniquement.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_REPLACE_ME"
CLERK_SECRET_KEY="sk_test_REPLACE_ME"

# GEMINI API (optionnel ; à utiliser uniquement côté serveur)
GEMINI_API_KEY="REPLACE_ME"

# URL de l'application
APP_URL="https://example.com"
